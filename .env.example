# AMORA Project Environment Configuration

# Application settings
APP_NAME="AMORA RAG System"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Database Settings (PostgreSQL or fallback SQLite)
DATABASE_URL="sqlite:///./amora.db"
# Example PostgreSQL: "postgresql://user:password@localhost:5432/amora_db"

# LLM Provider Configuration
# Supported: "qwen", "ollama", "amora-fast", "groq", "gemini", "huggingface", "mistral", "cohere"
LLM_PROVIDER="ollama"
OLLAMA_HOST="http://localhost:11434"
# Must be a tag reported by `ollama list`. Check with GET /llm/status.
QWEN_MODEL_NAME="qwen3.6:latest"
OPENAI_API_KEY=""

# ── Local Ollama generation limits ───────────────────────────────────────────
# Read timeout for local generation, in seconds. Large local models are slow on
# first load: qwen3.6:latest (~24 GB) needs 100-150s for a RAG answer on CPU.
# A timeout that is too low makes the client abandon the model and fall back to a
# canned stub, so this must be comfortably above the real generation time.
OLLAMA_TIMEOUT_SECONDS=300

# Maximum tokens the model may generate. This is a CAP, not a target. Reasoning
# models such as qwen3.6 emit a chain of thought before the answer, so a cap that
# is too low truncates mid-reasoning and no answer is ever produced.
# Use 1024 only for small non-reasoning models.
OLLAMA_NUM_PREDICT=4096

# Set true to let reasoning models emit their chain of thought. Leave false for
# clean answers: with thinking disabled, Ollama puts the answer in `content` and
# the reasoning in `thinking`, which AMORA reads from `content`.
OLLAMA_THINK=false

# Web UI
# The UI is Flutter. Point this at a compiled bundle (from `flutter build web`) to have
# FastAPI serve it at /app. Defaults to frontend/flutter_app/build/web
# FLUTTER_WEB_DIR="./frontend/flutter_app/build/web"

# ── Free LLM Providers (answers appear on AMOF website — no redirect needed) ─
# Which free provider to use by default (groq recommended — fastest & free)
FREE_LLM_PROVIDER="groq"

# Groq — fastest free LLM (14,400 req/day) — Llama 3.1 / Gemma2
# Get free key at: https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"

# Google Gemini — 1,500 req/day free (gemini-1.5-flash)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# HuggingFace Inference API — many open models, free with rate limits
# Get free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=""
HUGGINGFACE_MODEL="mistralai/Mistral-7B-Instruct-v0.3"

# Mistral AI — free tier available
# Get free key at: https://console.mistral.ai
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"

# Cohere — 1,000 req/month free
# Get free key at: https://dashboard.cohere.com
COHERE_API_KEY=""
COHERE_MODEL="command-r"

# Embedding Configuration
# BAAI/bge-small-en-v1.5 is 384-dim, matching EMBEDDING_DIMENSION below.
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
EMBEDDING_DIMENSION=384
# Which encoder backs the FAISS pre-filter:
#   "auto"  -> use EMBEDDING_MODEL, fall back to the deterministic hash encoder if it
#              cannot be loaded (relevance then becomes lexical-overlap only)
#   "model" -> require EMBEDDING_MODEL; fail loudly instead of degrading
#   "hash"  -> always use the hash encoder (no semantic similarity)
EMBEDDING_BACKEND="auto"

# AMORA Default Profiling Weights & Parameters
ALPHA_RELIABILITY=0.6
BETA_AVAILABILITY=0.4
LAMBDA_FRESHNESS=0.001
BAYES_ALPHA=1.0
BAYES_BETA=1.0
PREFILTER_TOP_N=200
DEFAULT_TOP_K=5

# Efficiency Calculation Coefficients
EFFICIENCY_ALPHA_TOKENS=0.4
EFFICIENCY_BETA_LATENCY=0.3
EFFICIENCY_GAMMA_COST=0.3
