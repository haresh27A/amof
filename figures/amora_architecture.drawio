Size=12;fontColor=#263238;align=center;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="161" y="346" width="231" height="91" as="geometry"/></mxCell><mxCell id="intent" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1565C0&quot;&gt;Intent Tokens&lt;/font&gt;&lt;/b&gt;&lt;br&gt;live stock lookup +&lt;br&gt;cross-source verification" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontColor=#263238;align=center;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="444" y="346" width="231" height="91" as="geometry"/></mxCell><mxCell id="qplus" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#1565C0&quot;&gt;Reformulated Query q⁺&lt;/font&gt;&lt;/b&gt;&lt;br&gt;current stock SKU-1042 Chennai&lt;br&gt;warehouse | compare Q3 inventory report" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fontSize=12;fontColor=#263238;align=center;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="777" y="346" width="280" height="91" as="geometry"/></mxCell><mxCell id="s3" style="endArrow=none;html=1;dashed=1;strokeColor=#9E9E9E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="14" y="483" as="sourcePoint"/><mxPoint x="1106" y="483" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t3" value="AMORA Routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#4527A0;fontColor=#4527A0;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="140" y="490" width="174" height="28" as="geometry"/></mxCell><mxCell id="funnel" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#4527A0&quot;&gt;Two-Stage FAISS Funnel&lt;/font&gt;&lt;/b&gt;&lt;br&gt;N = 10,000 → M = 55 candidates&lt;br&gt;3.26 ms  |  SRR = 99.45%" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=2;fontSize=12;fontColor=#263238;align=center;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="777" y="542" width="280" height="91" as="geometry"/></mxCell><mxCell id="moo" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#4527A0&quot;&gt;6-D Multi-Objective Scoring&lt;/font&gt;&lt;/b&gt;&lt;br&gt;R, L, F, C, H, K&lt;br&gt;Σⱼ Wⱼ = 1 (Pareto-optimal)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=2;fontSize=12;fontColor=#263238;align=center;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="444" y="542" width="231" height="91" as="geometry"/></mxCell><mxCell id="topk" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#4527A0&quot;&gt;Top-K Selected Tools&lt;/font&gt;&lt;/b&gt;&lt;br&gt;inventory_db (SQL)&lt;br&gt;stock_api (REST), q3_report (DOC)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#4527A0;strokeWidth=2;fontSize=12;fontColor=#263238;align=center;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="161" y="542" width="231" height="91" as="geometry"/></mxCell><mxCell id="s4" style="endArrow=none;html=1;dashed=1;strokeColor=#9E9E9E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="14" y="672" as="sourcePoint"/><mxPoint x="1106" y="672" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t4" value="Evidence Fusion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontColor=#2E7D32;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="140" y="679" width="196" height="28" as="geometry"/></mxCell><mxCell id="outs" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#2E7D32&quot;&gt;Tool Outputs&lt;/font&gt;&lt;/b&gt;&lt;br&gt;SQL: 150 units (2 h ago)&lt;br&gt;REST: 150 units (live)&lt;br&gt;DOC: 90 units (Q3 snapshot)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#263238;align=center;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="161" y="732" width="231" height="91" as="geometry"/></mxCell><mxCell id="engine" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#2E7D32&quot;&gt;Fusion Engine&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Hash-window dedup: 3 → 2 facts&lt;br&gt;O(E²) conflict graph: 150 vs 90&lt;br&gt;Prompt tokens −26.7%" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#263238;align=center;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="444" y="732" width="231" height="91" as="geometry"/></mxCell><mxCell id="fused" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#2E7D32&quot;&gt;Fused Evidence Context&lt;/font&gt;&lt;/b&gt;&lt;br&gt;[FACT] stock = 150 (fresh, reliable)&lt;br&gt;[CONFLICT] Q3 report = 90 (stale)&lt;br&gt;provenance tags attached" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fontSize=12;fontColor=#263238;align=center;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="777" y="732" width="280" height="91" as="geometry"/></mxCell><mxCell id="s5" style="endArrow=none;html=1;dashed=1;strokeColor=#9E9E9E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="14" y="850" as="sourcePoint"/><mxPoint x="1106" y="850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="llm" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#EF6C00&quot;&gt;Local LLM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Qwen 2.5 7B (Q4_K_M)&lt;br&gt;zero data egress" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#EF6C00;strokeWidth=2;fontSize=12;fontColor=#263238;align=center;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="812" y="901" width="210" height="74" as="geometry"/></mxCell><mxCell id="answer" value="SKU-1042 currently has 150 units in the Chennai warehouse [inventory_db,&lt;br&gt;updated 2 h ago]. Note: the Q3 report lists 90 units; the gap reflects&lt;br&gt;post-Q3 restocking, so the live ledger value is authoritative." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7CB342;strokeWidth=2;fontSize=12;fontColor=#263238;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="168" y="901" width="539" height="74" as="geometry"/></mxCell><mxCell id="cap" value="LLM Continual Generation based on Fused Evidence" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#78909C;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="228" y="973" width="420" height="28" as="geometry"/></mxCell><mxCell id="iter" value="↻ Iteration" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#1565C0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="-32" y="525" width="112" height="28" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#263238;fontSize=11;fontStyle=1;endArrow=block;endFill=1;exitX=0.03;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="query" target="eval"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#263238;fontSize=11;fontStyle=1;endArrow=block;endFill=1;exitX=0.03;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="query" target="selfa"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#263238;fontSize=11;fontStyle=1;endArrow=block;endFill=1;exitX=0.03;exitY=1;exitD