<mxfile host="app.diagrams.net"><diagram name="AMORA Architecture"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="query" value="Query:  What is the current stock of SKU-1042 in the Chennai warehouse, and does it match the Q3 inventory report?" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7CB342;strokeWidth=2;fontSize=13;fontColor=#263238;align=left;spacingLeft=8;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="18" width="1022" height="43" as="geometry"/></mxCell><mxCell id="s1" style="endArrow=none;html=1;dashed=1;strokeColor=#9E9E9E;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="14" y="84" as="sourcePoint"/><mxPoint x="1106" y="84" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t1" value="IE-KRT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#D84315;fontColor=#D84315;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="140" y="95" width="95" height="28" as="geometry"/></mxCell><mxCell id="eval" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#D84315&quot;&gt;Evaluator&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Complexity  E = 0.72&lt;br&gt;Sensitivity  Sᵢ = 0.76" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#D84315;strokeWidth=2;fontSize=12;fontColor=#263238;align=center;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="161" y="124" width="203" height="74" as="geometry"/></mxCell><mxCell id="selfa" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot; color=&quot;#D84315&quot;&gt;LLM Self-Assessment&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Confidence  mᵢ = 0.18" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#D84315;strokeWidt